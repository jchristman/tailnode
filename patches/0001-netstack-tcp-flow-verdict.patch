Subject: [netstack] let a TCP flow be dropped instead of reset

GetTCPHandlerForFlow can only accept a flow or reject it, and rejecting sends
a RST, which a client reports as "connection refused". A subnet router that
fails to reach a backend usually has no proof the port is closed: the target
may be filtering it, or the router may have hit its own dial or connection
ceiling. Answering with a RST reports all of those as closed, which is wrong
often enough to matter for anything scanning through the router, and the
verdict even flips with unrelated timing changes because it races the client's
own timeout.

This adds an optional GetTCPFlowVerdict hook that can additionally ask for the
flow to be dropped, which leaves the SYN unanswered so the client times out.
gVisor's ForwarderRequest.Complete(false) already releases the segment without
replying, so no resources leak.

The change is additive: GetTCPFlowVerdict is consulted only when set, and a nil
value leaves the existing GetTCPHandlerForFlow path untouched.

Upstream: not yet submitted.
Applies to: tailscale.com v1.98.2

--- a/vendor/tailscale.com/wgengine/netstack/netstack.go
+++ b/vendor/tailscale.com/wgengine/netstack/netstack.go
@@ -154,6 +154,26 @@
 	refs.SetLeakMode(lm)
 }
 
+// TCPFlowVerdict is what [Impl.GetTCPFlowVerdict] decides to do with a flow.
+type TCPFlowVerdict int
+
+const (
+	// TCPFlowPassThrough leaves the flow to the default handling, as
+	// GetTCPHandlerForFlow does when it returns intercept=false.
+	TCPFlowPassThrough TCPFlowVerdict = iota
+
+	// TCPFlowHandle gives the flow to the returned handler, completing the
+	// client handshake first.
+	TCPFlowHandle
+
+	// TCPFlowReset answers with a RST, which a client reports as a refused
+	// connection.
+	TCPFlowReset
+
+	// TCPFlowDrop answers with nothing and lets the client time out.
+	TCPFlowDrop
+)
+
 // Impl contains the state for the netstack implementation,
 // and implements wgengine.FakeImpl to act as a userspace network
 // stack when Tailscale is running in fake mode.
@@ -171,6 +191,22 @@
 	// over the TCP conn.
 	GetTCPHandlerForFlow func(src, dst netip.AddrPort) (handler func(net.Conn), intercept bool)
 
+	// GetTCPFlowVerdict conditionally handles an incoming TCP flow, like
+	// GetTCPHandlerForFlow, but can also ask for the flow to be dropped
+	// without a reply. When non-nil it is consulted first, and
+	// GetTCPHandlerForFlow is only used if it returns TCPFlowPassThrough.
+	//
+	// GetTCPHandlerForFlow cannot express a drop: rejecting a flow there sends
+	// a RST, which a client reports as "connection refused". A subnet router
+	// that could not reach a backend has usually not been told the port is
+	// closed — the target may be filtering it, or the router may have hit its
+	// own capacity limits — and answering with a RST turns either case into a
+	// false "closed". Dropping instead leaves the client to time out, which is
+	// what makes a port scanner report the port as filtered.
+	//
+	// A nil value preserves the pre-existing behavior.
+	GetTCPFlowVerdict func(src, dst netip.AddrPort) (handler func(net.Conn), verdict TCPFlowVerdict)
+
 	// GetUDPHandlerForFlow conditionally handles an incoming UDP flow for the
 	// provided (src/port, dst/port) 4-tuple.
 	//
@@ -1634,6 +1670,27 @@
 			if c == nil {
 				return
 			}
+			handler(c)
+			return
+		}
+	}
+
+	if ns.GetTCPFlowVerdict != nil {
+		handler, verdict := ns.GetTCPFlowVerdict(clientRemoteAddrPort, dstAddrPort)
+		switch verdict {
+		case TCPFlowDrop:
+			// Complete without a reset: the segment is released and the SYN
+			// goes unanswered, so the client times out.
+			r.Complete(false)
+			return
+		case TCPFlowReset:
+			r.Complete(true)
+			return
+		case TCPFlowHandle:
+			c := getConnOrReset() // will send a RST if it fails
+			if c == nil {
+				return
+			}
 			handler(c)
 			return
 		}
